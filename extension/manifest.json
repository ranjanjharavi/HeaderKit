{
  "manifest_version": 3,
  "name": "HeaderKit - Modify Request Headers",
  "version": "1.2.1",
  "minimum_chrome_version": "120",
  "description": "Create scoped request-header rules for HTTPS sites. Switch profiles, auto-pause sessions, and manage site access locally.",
  "homepage_url": "https://ranjanjharavi.github.io/HeaderKit/",
  "permissions": ["activeTab", "alarms", "declarativeNetRequestWithHostAccess", "storage"],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      }
    },
    "toggle-master": {
      "suggested_key": {
        "default": "Alt+Shift+X"
      },
      "description": "Pause or resume all HeaderKit header rules"
    }
  },
  "icons": {
    "16": "icons/headerkit-16.png",
    "32": "icons/headerkit-32.png",
    "48": "icons/headerkit-48.png",
    "128": "icons/headerkit-128.png"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "HeaderKit",
    "default_icon": {
      "16": "icons/headerkit-16.png",
      "32": "icons/headerkit-32.png",
      "48": "icons/headerkit-48.png"
    }
  }
}
